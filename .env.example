# API Keys
# FDA API Key - Optional but increases rate limits
# Get your key at: https://open.fda.gov/apis/authentication/
FDA_API_KEY=your_fda_api_key_here

# PubMed API Key - Optional but increases rate limits
# Get your key at: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=your_pubmed_api_key_here

# UMLS API Key - Required for medical terminology tools
# Get your key at: https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your_umls_api_key_here

# Cache Configuration
CACHE_TTL=86400

# Server Configuration (for HTTP mode)
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Database paths (relative to project root)
# These are optional and will default to SQLite files in the project root
CACHE_DB_PATH=healthcare_cache.db
USAGE_DB_PATH=healthcare_usage.db

# Stripe Integration - Only needed for paid tier implementation
# STRIPE_API_KEY=your_stripe_api_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
# STRIPE_BASIC_MONTHLY_PRICE_ID=your_price_id_here
# STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=your_price_id_here